      amount: 2
    - kind: 4
      amount: 1
    conditionalEffects: []
  - id: teach.compare
    stepId: teach
    stationId: nam
    nextStepId: assess
    label: "C\xF9ng Nam \u0111\u1ED1i chi\u1EBFu hai quan s\xE1t"
    tradeoff: "8 ph\xFAt \xB7 gi\u1EEF \u0111i\u1EC1u ki\u1EC7n l\u01B0\u1EE3ng m\u01B0a nh\u01B0 nhau v\xE0 t\xECm b\u1EB1ng ch\u1EE9ng."
    feedback: "Nam: \u2018C\u1EA7n so s\xE1nh c\xF9ng l\u01B0\u1EE3ng m\u01B0a v\xE0 c\xF9ng th\u1EDDi gian quan s\xE1t\u2019. Nh\xF3m s\u1EEDa c\xE1ch gi\u1EA3i th\xEDch b\u1EB1ng b\u1EB1ng ch\u1EE9ng thay v\xEC \u0111o\xE1n."
    evidence: "\u0110\u1ED1i chi\u1EBFu d\u1EEF li\u1EC7u v\xE0 ki\u1EC3m tra gi\u1EA3 \u0111\u1ECBnh c\xF9ng h\u1ECDc sinh."
    npcId: nam
    requiresFlag: 
