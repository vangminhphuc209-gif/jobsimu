  - id: assess.tickets
    stepId: assess
    stationId: tickets
    nextStepId: reflect
    label: "Thu v\xE0 \u0111\u1ED1i chi\u1EBFu phi\u1EBFu cu\u1ED1i gi\u1EDD"
    tradeoff: "7 ph\xFAt \xB7 c\xF3 s\u1EA3n ph\u1EA9m t\u1EEBng nh\xF3m \u0111\u1EC3 chu\u1EA9n b\u1ECB ti\u1EBFt sau."
    feedback: "Phi\u1EBFu cho th\u1EA5y m\u1ED9t nh\xF3m c\xF2n nh\u1EA7m \u2018n\u01B0\u1EDBc bi\u1EBFn m\u1EA5t\u2019 v\u1EDBi \u2018n\u01B0\u1EDBc th\u1EA5m\u2019. B\u1EA1n ghi l\u1EA1i v\xED d\u1EE5 c\u1EA7n d\xF9ng \u1EDF ti\u1EBFt sau. Ti\u1EBFt h\u1ECDc \u0111\xE3 k\u1EBFt th\xFAc."
    evidence: "Thu s\u1EA3n ph\u1EA9m h\u1ECDc t\u1EADp v\xE0 x\xE1c \u0111\u1ECBnh \u0111i\u1EC3m c\u1EA7n ki\u1EC3m tra l\u1EA1i."
    npcId: 
    requiresFlag: 
    forbidsFlag: 
    setsFlag: tickets-collected
    minutes: 7
