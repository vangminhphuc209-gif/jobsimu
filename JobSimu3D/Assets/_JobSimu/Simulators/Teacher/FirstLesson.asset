  timedEvents:
  - id: equipment.waited
    stepId: teach
    requiresFlag: projector
    feedback: "\u0110\xE3 ch\u1EDD thi\u1EBFt b\u1ECB th\xEAm hai ph\xFAt. M\xE1y chi\u1EBFu ch\u01B0a ho\u1EA1t \u0111\u1ED9ng; chuy\u1EC3n sang b\u1EA3ng ho\u1EB7c trao \u0111\u1ED5i tr\u1EF1c ti\u1EBFp v\u1EABn kh\u1EA3 thi."
    delayMinutes: 2
