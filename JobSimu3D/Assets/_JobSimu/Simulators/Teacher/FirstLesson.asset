    conditionalEffects: []
  - id: assess.oral
    stepId: assess
    stationId: linh
    nextStepId: reflect
    label: "M\u1EDDi Linh t\u1ED5ng k\u1EBFt b\u1EB1ng l\u1EDDi"
    tradeoff: "3 ph\xFAt \xB7 nhanh, nh\u01B0ng ch\u01B0a c\xF3 b\u1EB1ng ch\u1EE9ng c\u1EE7a c\u1EA3 l\u1EDBp."
    feedback: "Linh t\xF3m t\u1EAFt \u0111\u01B0\u1EE3c n\u1ED9i dung. B\u1EA1n ch\u01B0a th\u1EC3 suy ra c\u1EA3 l\u1EDBp \u0111\xE3 hi\u1EC3u; ghi vi\u1EC7c ki\u1EC3m tra th\xEAm v\xE0o ti\u1EBFt sau. Ti\u1EBFt h\u1ECDc \u0111\xE3 k\u1EBFt th\xFAc."
    evidence: "Thu ph\u1EA3n h\u1ED3i mi\u1EC7ng v\xE0 th\u1EEBa nh\u1EADn gi\u1EDBi h\u1EA1n d\u1EEF li\u1EC7u."
    npcId: linh
