    - kind: 1
      amount: 2
    - kind: 2
      amount: 1
    conditionalEffects: []
  - id: teach.explain
    stepId: teach
    stationId: board
    nextStepId: assess
    label: "V\u1EBD s\u01A1 \u0111\u1ED3 d\xF2ng n\u01B0\u1EDBc tr\xEAn b\u1EA3ng"
    tradeoff: "5 ph\xFAt \xB7 ti\u1EBFt ki\u1EC7m th\u1EDDi gian; ch\u01B0a nghe l\xFD gi\u1EA3i c\u1EE7a t\u1EEBng nh\xF3m."
    feedback: "S\u01A1 \u0111\u1ED3 \u0111\xE3 l\xE0m r\xF5 d\xF2ng n\u01B0\u1EDBc th\u1EA5m v\xE0 ch\u1EA3y tr\xEAn b\u1EC1 m\u1EB7t. M\u1ED9t s\u1ED1 h\u1ECDc sinh ghi l\u1EA1i; ch\u01B0a bi\u1EBFt c\xE1c em t\u1EF1 gi\u1EA3i th\xEDch \u0111\u01B0\u1EE3c \u0111\u1EBFn \u0111\xE2u."
    evidence: "D\xF9ng s\u01A1 \u0111\u1ED3 thay th\u1EBF \u0111\u1EC3 duy tr\xEC ti\u1EBFt h\u1ECDc."
    npcId: 
