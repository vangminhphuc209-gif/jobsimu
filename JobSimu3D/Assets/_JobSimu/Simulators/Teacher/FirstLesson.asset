  m_Script: {fileID: 11500000, guid: 5ec1f9049a6fc186995e407fd93f9e56, type: 3}
  m_Name: FirstLesson
  m_EditorClassIdentifier: JobSimu.Runtime::JobSimu.Quests.ScenarioDefinition
  id: teacher.first-lesson
  title: "Ti\u1EBFt KHTN L\u1EDBp 8A \xB7 V\xEC sao s\xE2n tr\u01B0\u1EDDng \u0111\u1ECDng n\u01B0\u1EDBc sau m\u01B0a?"
  context: "Tr\u01B0\u1EDDng THCS B\xECnh Minh (h\u01B0 c\u1EA5u). Gi\xE1o vi\xEAn m\u1EDBi ph\u1EE5 tr\xE1ch ti\u1EBFt Khoa h\u1ECDc t\u1EF1 nhi\xEAn L\u1EDBp 8A (45 ph\xFAt) d\u01B0\u1EDBi s\u1EF1 h\u01B0\u1EDBng d\u1EABn c\u1EE7a c\xF4 Mai: \u0111i\u1EC1u tra v\xEC sao m\u1ED9t s\u1ED1 v\u1ECB tr\xED trong s\xE2n tr\u01B0\u1EDDng \u0111\u1ECDng n\u01B0\u1EDBc sau m\u01B0a qua quan s\xE1t v\xE0 so s\xE1nh m\u1EABu. T\xECnh hu\u1ED1ng thi\u1EBFt k\u1EBF tr\u1EA3i nghi\u1EC7m ngh\u1EC1, ch\u01B0a tuy\xEAn b\u1ED1 th\u1EA9m \u0111\u1ECBnh ch\u01B0\u01A1ng tr\xECnh ch\xEDnh th\u1EE9c."
  contentVersion: 2
  profession: 0
  initialStepId: brief
  initialMinute: 430
  lessonNominalStartMinute: 450
  lessonEndMinute: 495
  participants:
  - mai
  - linh
  - an
  - binh
  - nam
  - vy
  - khanh
  - ha
  - trang
  - duc
  - minh
  - hung
  - thao
  steps:
  - id: brief
    objective: "G\u1EB7p c\xF4 Mai \u1EDF s\xE2n tr\u01B0\u1EDDng \u0111\u1EC3 nh\u1EADn m\u1EE5c ti\xEAu ti\u1EBFt KHTN L\u1EDBp 8A (c\xF3 th\u1EC3 h\u1ECFi th\xEAm & xem v\u0169ng n\u01B0\u1EDBc m\u1EABu)."
    phase: 0
    terminal: 0
  - id: prepare
    objective: "Ph\xF2ng gi\xE1o vi\xEAn: \u0111\u1ECDc b\xE0i c\u0169, ki\u1EC3m tra thi\u1EBFt b\u1ECB v\xE0 ph\u1ED1i h\u1EE3p h\u1ECDc li\u1EC7u tr\u01B0\u1EDBc gi\u1EDD v\xE0o L\u1EDBp 8A."
    phase: 1
    terminal: 0
  - id: begin
    objective: "L\u1EDBp 8A (B\u1EA3ng): n\xEAu nhi\u1EC7m v\u1EE5 \u0111i\u1EC1u tra v\xE0 ki\u1EC3m tra xem h\u1ECDc sinh hi\u1EC3u y\xEAu c\u1EA7u hay ch\u01B0a."
    phase: 2
    terminal: 0
  - id: teach
    objective: "L\u1EDBp 8A: quan s\xE1t b\xE0i 4 nh\xF3m, h\u1ECFi l\xE0m r\xF5, g\u1EE3i \xFD/minh h\u1ECDa, m\u1EDF r\u1ED9ng, ki\u1EC3m tra l\u1EA1i sau h\u1ED7 tr\u1EE3."
    phase: 3
    terminal: 0
  - id: assess
    objective: "L\u1EDBp 8A: thu b\u1EB1ng ch\u1EE9ng hi\u1EC3u b\xE0i (phi\u1EBFu 4 nh\xF3m, h\u1ECFi mi\u1EC7ng, phi\u1EBFu ng\u1EAFn) v\xE0 \u0111i\u1EC1u ch\u1EC9nh n\u1EBFu c\u1EA7n."
    phase: 4
    terminal: 0
  - id: reflect
    objective: "Ph\xF2ng gi\xE1o vi\xEAn / C\xF4 Mai: nh\xECn l\u1EA1i di\u1EC5n bi\u1EBFn, ch\u1ECDn b\u1EB1ng ch\u1EE9ng v\xE0 ph\u1EA3n t\u01B0 ti\u1EBFt h\u1ECDc."
    phase: 5
    terminal: 0
  - id: complete
    objective: "\u0110\xE3 ho\xE0n th\xE0nh ti\u1EBFt h\u1ECDc L\u1EDBp 8A. Nh\u1EA5n [P] \u0111\u1EC3 xem H\u1ED3 s\u01A1 tr\u1EA3i nghi\u1EC7m ngh\u1EC1 gi\xE1o vi\xEAn."
    phase: 6
    terminal: 1
  actions:
  - id: brief.ask_class
    stepId: brief
    stationId: mai
    nextStepId: brief
    label: "H\u1ECFi c\xF4 Mai v\u1EC1 th\xF3i quen h\u1ECDc t\u1EADp c\u1EE7a L\u1EDBp 8A"
    tradeoff: "1 ph\xFAt \xB7 bi\u1EBFt th\xEAm t\xEDn hi\u1EC7u ban \u0111\u1EA7u c\xF4 Mai t\u1EEBng quan s\xE1t tu\u1EA7n tr\u01B0\u1EDBc."
    feedback: "C\xF4 Mai: 'L\u1EDBp 8A c\xF3 4 nh\xF3m (12 b\u1EA1n). Tu\u1EA7n tr\u01B0\u1EDBc v\xE0i b\u1EA1n hay \u0111o\xE1n k\u1EBFt lu\u1EADn tr\u01B0\u1EDBc khi \u0111o th\u1EED. Ri\xEAng Minh t\u1EEBng nh\u1EA7m gi\u1EEFa y\xEAu c\u1EA7u quan s\xE1t v\u1EDBi vi\u1EC7c k\u1EC3 t\xEAn v\u1EADt b\u1EA9n; c\xF2n Linh l\xE0m b\xE0i c\u1EA9n th\u1EADn nh\u01B0ng \xEDt gi\u01A1 tay tr\u01B0\u1EDBc l\u1EDBp.'"
    evidence: "H\u1ECFi th\xF4ng tin n\u1EC1n v\u1EC1 th\xF3i quen h\u1ECDc t\u1EADp c\u1EE7a l\u1EDBp tr\u01B0\u1EDBc khi chu\u1EA9n b\u1ECB."
    npcId: mai
    targetGroupId: 
    requiresFlag: 
    forbidsFlag: 
